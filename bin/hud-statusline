#!/bin/bash

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG="$HOME/.claude-code-prompt-hud/config"

[ -f "$CONFIG" ] && source "$CONFIG"
HUD_LANG=${HUD_LANG:-zh}
HUD_MODE=${HUD_MODE:-text}
HUD_MODEL=${HUD_MODEL:-opus}
HUD_VERSION="v0.1"
HUD_FIELDS=${HUD_FIELDS:-MODEL,CTX,TIME,COST,DIFF,TOKEN,REQ,DIR,PATH,BRANCH,VER,CPU,MEM}

if [ ! -t 0 ]; then
  HUD_STATUSLINE_INPUT="$(cat)"
  export HUD_STATUSLINE_INPUT
fi

if [ -n "$HUD_STATUSLINE_INPUT" ] && command -v python3 >/dev/null 2>&1; then
  eval "$(
    python3 - <<'PY'
import json
import os
import shlex

raw = os.environ.get("HUD_STATUSLINE_INPUT", "")
try:
    data = json.loads(raw) if raw.strip() else {}
except Exception:
    data = {}

def emit(name, value):
    if value is None or value == "":
        return
    print(f"export {name}={shlex.quote(str(value))}")

model = data.get("model")
if isinstance(model, dict):
    emit("HUD_STATUS_MODEL", model.get("id") or model.get("display_name") or model.get("name"))
else:
    emit("HUD_STATUS_MODEL", model)

emit("HUD_TRANSCRIPT_PATH", data.get("transcript_path"))
emit("HUD_STATUS_SESSION_ID", data.get("session_id") or data.get("sessionId"))

ctx = data.get("context_window") or {}
if isinstance(ctx, dict):
    emit("HUD_CONTEXT_WINDOW_SIZE", ctx.get("context_window_size"))
    emit("HUD_CONTEXT_USED_PERCENT", ctx.get("used_percentage"))
    current = ctx.get("current_usage")
    if isinstance(current, dict):
        total = 0
        for key in ("input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"):
            try:
                total += int(current.get(key) or 0)
            except Exception:
                pass
        emit("HUD_CONTEXT_USED_TOKENS", total)
    else:
        total = 0
        for key in ("total_input_tokens", "total_output_tokens"):
            try:
                total += int(ctx.get(key) or 0)
            except Exception:
                pass
        if total:
            emit("HUD_CONTEXT_USED_TOKENS", total)
PY
  )"
fi

source "$BASE_DIR/lang/${HUD_LANG}.sh"
source "$BASE_DIR/metrics/git.sh"
source "$BASE_DIR/metrics/context.sh"
source "$BASE_DIR/metrics/token.sh"
source "$BASE_DIR/metrics/cost.sh"
source "$BASE_DIR/metrics/resource.sh"
source "$BASE_DIR/metrics/session.sh"

c()  { printf "\e[38;5;%sm" "$1"; }
rst(){ printf "\e[0m"; }

on() { echo "$HUD_FIELDS" | tr ',' '\n' | grep -q "^$1$"; }

# emoji 图标映射
emoji_icon() {
  case "$1" in
    MODEL)  echo "🤖" ;;
    CTX)    echo "📄" ;;
    TIME)   echo "🕙" ;;
    COST)   echo "💲" ;;
    DIFF)   echo ""   ;;  # DIFF 特殊处理，无图标前缀
    TOKEN)  echo "⚡" ;;
    REQ)    echo "🔄" ;;
    USAGE)  echo "📊" ;;
    DIR)    echo "📖" ;;
    PATH)   echo "📂" ;;
    BRANCH) echo "⎇" ;;
    VER)    echo "🏷️" ;;
    CPU)    echo "⚙️" ;;
    MEM)    echo "💾" ;;
  esac
}

out=""

add() {
  local field="$1" color="$2" label="$3" value="$4"
  on "$field" || return
  [ -n "$out" ] && out+="$(c 255)｜$(rst)"
  if [ "$HUD_MODE" = "emoji" ]; then
    local icon
    icon=$(emoji_icon "$field")
    out+="$(c $color)${icon} ${value}$(rst)"
  else
    out+="$(c $color)${label}: ${value}$(rst)"
  fi
}

# DIFF 在 emoji 模式下特殊渲染
add_diff() {
  on "DIFF" || return
  [ -n "$out" ] && out+="$(c 255)｜$(rst)"
  if [ "$HUD_MODE" = "emoji" ]; then
    local detail
    detail=$(git_diff_detail)
    local added removed
    added=$(echo "$detail" | grep -oE '\+[0-9]+')
    removed=$(echo "$detail" | grep -oE '\-[0-9]+')
    out+="$(c 82)${added}$(rst) $(c 203)${removed}$(rst)"
  else
    out+="$(c 203)${L_DIFF}: $(git_changes)$(rst)"
  fi
}

render_progress_bar() {
  local pct="$1" color="$2" filled empty bar i
  filled=$(( pct * 10 / 100 ))
  [ "$filled" -gt 10 ] && filled=10
  [ "$filled" -lt 0 ] && filled=0
  empty=$(( 10 - filled ))
  bar=""
  i=0; while [ $i -lt $filled ]; do bar+="$(c "$color")█$(rst)"; i=$(( i+1 )); done
  i=0; while [ $i -lt $empty  ]; do bar+="$(c 240)░$(rst)"; i=$(( i+1 )); done
  printf "%s" "$bar"
}

# CTX 专用：带颜色进度条
add_ctx() {
  on "CTX" || return
  [ -n "$out" ] && out+="$(c 255)｜$(rst)"

  local pct tokens window tokens_display window_display bar color
  pct=$(context_percent)
  tokens=$(context_used_tokens)
  window=$(_get_context_window)
  tokens_display=$(format_tokens_compact "$tokens")
  window_display=$(format_tokens_compact "$window")

  # 颜色随用量变化：绿 <60% → 黄 60-85% → 红 ≥85%
  if   [ "$pct" -ge 85 ]; then color=196
  elif [ "$pct" -ge 60 ]; then color=214
  else color=82
  fi

  bar=$(render_progress_bar "$pct" "$color")

  if [ "$HUD_MODE" = "emoji" ]; then
    out+="$(emoji_icon CTX) ${bar} $(c $color)${pct}%$(rst) $(c 245)(${tokens_display}/${window_display})$(rst)"
  else
    out+="$(c $color)${L_CTX}:$(rst) ${bar} $(c $color)${pct}%$(rst) $(c 245)(${tokens_display}/${window_display})$(rst)"
  fi
}

add MODEL  84  "${L_MODEL}"  "$(detect_model)"
add_ctx
add TIME  245  "${L_TIME}"   "$(session_time)"
add COST  214  "${L_COST}"   "$(session_cost)"
add_diff
add TOKEN  81  "${L_TOKEN}"  "$(session_tokens)"
add REQ   245  "${L_REQ}"    "$(request_count)"
add DIR   245  "${L_DIR}"    "$(basename "$PWD")"
add PATH  245  "${L_PATH}"   "${PWD}"
add BRANCH 75  "${L_BRANCH}" "$(git_branch)"
add VER   245  "${L_VER}"    "${HUD_VERSION}"
add CPU   245  "${L_CPU}"    "$(cpu_usage)"
add MEM   245  "${L_MEM}"    "$(mem_usage)"

printf "%s\n" "$out"
echo "$PWD" > /tmp/claude_hud_pwd
